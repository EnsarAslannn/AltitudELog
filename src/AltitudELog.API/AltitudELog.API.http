@baseUrl = http://localhost:5264

###
POST {{baseUrl}}/Auth/register
Content-Type: application/json

{
  "username": "jdoe",
  "password": "P@ssw0rd123",
  "name": "John Doe",
  "licenseNumber": "TR-12345"
}

###

###
# @name login
POST {{baseUrl}}/Auth/login
Content-Type: application/json

{
  "username": "jdoe",
  "password": "P@ssw0rd123"
}

###

###
POST {{baseUrl}}/Flights
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "originICAO": "LTFM",
  "destinationICAO": "EGLL",
  "flightTime": "03:45:00",
  "aircraftType": "A320",
  "date": "2026-07-16"
}

###

###
GET {{baseUrl}}/Flights
Accept: application/json

###

###
# Crew — assign, re-role, remove. All three are Captain/ChiefPilot only.
POST {{baseUrl}}/Crew
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "flightId": "00000000-0000-0000-0000-000000000000",
  "pilotId": "00000000-0000-0000-0000-000000000000",
  "dutyRole": "SIC"
}

###

###
PUT {{baseUrl}}/Crew/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "dutyRole": "PIC"
}

###

###
DELETE {{baseUrl}}/Crew/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{login.response.body.token}}

###

###
# CRM safety-review queue — Captain/ChiefPilot only.
GET {{baseUrl}}/CRMReports?status=Open&sortBy=SeverityLevel&sortDescending=true
Authorization: Bearer {{login.response.body.token}}
Accept: application/json

###

###
PUT {{baseUrl}}/CRMReports/00000000-0000-0000-0000-000000000000/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "status": "Closed"
}
